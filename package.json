{
  "name": "token-rush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "screenshot": "playwright test --project=chromium e2e/screenshots.spec.ts",
    "soak": "SOAK=1 vitest run tests/bot.test.ts",
    "balance": "BALANCE=1 vitest run tests/bot.test.ts",
    "test:safari": "playwright test --project=webkit e2e/smoke.spec.ts e2e/bot.spec.ts",
    "media": "MEDIA=1 playwright test --project=chromium e2e/media.spec.ts && node scripts/make-gif.mjs",
    "deploy": "npm run build && wrangler d1 migrations apply token-rush-leaderboard --remote && wrangler deploy",
    "dev:full": "npm run build && wrangler d1 migrations apply token-rush-leaderboard --local && wrangler dev"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
